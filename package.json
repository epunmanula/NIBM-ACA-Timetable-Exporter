{
  "name": "nibm-aca-timetable-exporter",
  "version": "1.0.0",
  "description": "Chrome Extension (Manifest V3) to extract and export NIBM ACA timetables to clean CSV files.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.js && node scripts/build.js",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "keywords": [
    "nibm",
    "timetable",
    "chrome-extension",
    "manifest-v3",
    "csv-exporter"
  ],
  "author": "NIBM Student Utility",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
